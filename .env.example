# =====================================================
# Bike Store Environment Variables
# Note: This file is an example and should not be committed to version control.
# =====================================================

# --------------------------------------
# Environment Configuration
# --------------------------------------
TIME_FORMAT=%Y-%m-%d %H:%M:%S
TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
LOG_LEVEL=INFO

# --------------------------------------
# Postgres Database Configuration
# --------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bike_store
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=changeme

# --------------------------------------
# MongoDB Configuration
# --------------------------------------
MONGO_URI=mongodb://localhost:27017/bike_store
MONGO_DB_NAME=bike_store
MONGO_PORT=27017
