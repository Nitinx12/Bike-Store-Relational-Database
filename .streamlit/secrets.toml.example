# .streamlit/secrets.toml.example — copy to .streamlit/secrets.toml (gitignored) and fill
# For Streamlit Cloud: paste these under App Settings → Secrets (TOML format)

[postgres]
host = "localhost"
port = 5432
database = "bike_store"
username = "postgres"
password = "admin"

# Optional — if you want the dashboard to hit the same .env-backed DB as the ETL:
# [mongo]
# uri = "mongodb://localhost:27017"
# database = "bike_store"
