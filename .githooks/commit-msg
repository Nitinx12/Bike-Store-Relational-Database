#!/usr/bin/env bash
# .githooks/commit-msg — enforce Conventional Commits
# Spec: https://www.conventionalcommits.org/
set -euo pipefail

MSG_FILE="$1"
msg=$(head -n1 "$MSG_FILE" 2>/dev/null || true)

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RESET='\033[0m'

# Allowed: feat, fix, chore, refactor, docs, test, style, perf, ci, build, revert
# Optional scope: feat(pipeline): ...
# Optional breaking: feat!: ...
# Subject: lowercase start, no trailing period
pattern='^(feat|fix|chore|refactor|docs|test|style|perf|ci|build|revert)(\(.+\))?(!)?: [a-z].+[^.]$'

if echo "$msg" | grep -Eq "$pattern"; then
  # Optional: check body mentions issue for fix:
  if echo "$msg" | grep -Eq '^fix(\(.+\))?(!)?:' && ! cat "$MSG_FILE" | grep -Eqi 'Closes #[0-9]+|Fixes #[0-9]+|Refs #[0-9]+|(#\d+)' ; then
    echo -e "${YELLOW}[WARN] fix: commit should reference an issue (e.g. 'Closes #123' in body)${RESET}" >&2
    # warning only — don't block
  fi
  exit 0
fi

# Allow merge/revert commits
if echo "$msg" | grep -Eq "^Merge (branch|pull)"; then exit 0; fi
if echo "$msg" | grep -Eq "^Revert \""; then exit 0; fi

echo -e "${RED}[FAIL] Invalid commit message${RESET}" >&2
echo -e "${RED}  Got: $msg${RESET}" >&2
echo "" >&2
echo "  Must match Conventional Commits:" >&2
echo "    <type>(<scope>): <subject>" >&2
echo "  Types: feat, fix, chore, refactor, docs, test, perf, ci, build, revert" >&2
echo "  Examples:" >&2
echo "    feat: add cohort analysis SQL script" >&2
echo "    fix: resolve PySpark memory leak in transform step" >&2
echo "    fix(pipeline): handle null updated_at in incremental load" >&2
echo "  See AGENTS.md §7 and .github/pull_request_template.md" >&2
exit 1
