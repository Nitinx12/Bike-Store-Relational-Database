# Pipeline runner image: executes main.py (preflight, load, SQL checks, GX).
# Build:   docker build -f Dockerfile.pipeline -t bike-store-pipeline .
# One run: docker run --rm --env-file .env bike-store-pipeline
# Custom:  docker run --rm --env-file .env bike-store-pipeline .venv/bin/python main.py --full
# Neon:    docker run --rm -e DATABASE_URL="..." -e MONGO_URI="..." bike-store-pipeline
FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1

WORKDIR /app

# Resolve locked dependencies with uv (no pip requirements file needed).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv
COPY pyproject.toml uv.lock ./
RUN /uv sync --frozen --no-dev

# Pipeline source only (.env/secrets excluded via .dockerignore — pass at runtime).
COPY main.py ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY contracts/ ./contracts/
COPY gx/ ./gx/
COPY tests/ ./tests/

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Default: one full pipeline pass, then the container exits.
CMD [".venv/bin/python", "main.py"]
